/**
 * Rofi Theme: Everforest Dark
 * Description: A soothing, warm dark theme based on the Everforest palette.
 */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: " Apps";
    display-run: " Run";
    display-window: " Window";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    /* Everforest Dark Palette */
    bg0:     #2d353b;
    bg1:     #343f44;
    bg2:     #3d484d;
    fg0:     #d3c6aa;
    fg1:     #9da9a0;
    accent:  #a7c080; /* Everforest Green */
    urgent:  #e67e80; /* Everforest Red */

    /* Global defaults */
    background-color: transparent;
    text-color:       @fg0;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    background-color: @bg0;
    border:           2px;
    border-color:     @accent;
    border-radius:    8px;
    width:            600px;
    padding:          15px;
}

mainbox {
    spacing: 15px;
}

inputbar {
    background-color: @bg1;
    border-radius:    8px;
    padding:          12px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg1;
    text-color:        @fg0;
}

listview {
    columns:       1;
    lines:         8;
    spacing:       5px;
    scrollbar:     false;
    border:        0px;
}

element {
    padding:       10px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg0;
}

element normal.urgent {
    background-color: @urgent;
    text-color:       @bg0;
}

element normal.active {
    background-color: @bg2;
    text-color:       @accent;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg0;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg0;
}

element selected.active {
    background-color: @accent;
    text-color:       @bg0;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg0;
}

element-icon {
    size:             24px;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: inherit;
    text-color:       inherit;
}

message {
    background-color: @bg1;
    border-radius:    8px;
    padding:          10px;
}

textbox {
    text-color: @fg0;
}
